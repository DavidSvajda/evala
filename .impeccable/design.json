  "narrative": {
    "northStar": "Quiet chess clubhouse",
    "overview": "The primary web application uses cream surfaces, forest green actions, sage and ivory chess squares, and locally hosted Manrope. A large playable board, readable notation and factual feedback give the workspace its character. Flat game rows and restrained separators keep the surrounding interface quiet.\n\nThe web has distinct overview, games, analysis, puzzles, insights, settings and account routes. Google sign-in is optional: guest and signed-in libraries remain separate, and each account has its own local library, preferences and training history. The account screen makes guest-game transfer explicit. Czech and English controls share the same visual system.\n\nThe companion browser extension is a separate compact surface: a graphite evaluation bar beside an existing chessboard, with warm white scores, muted brass accents and an anchored settings popover or popup. Its dark palette does not define the light web application's defaults. Both surfaces use Manrope, tabular score numerals and small SVG icons.",
    "keyCharacteristics": [
      "Cream and sage web surfaces with forest green actions.",
      "A primary playable board and restrained, separated data rows.",
      "Distinct routes and collapsible navigation.",
      "Factual labels for scores, training difficulty and unavailable estimates.",
      "A separate graphite companion evaluation bar."
    ],
    "rules": [
      {
        "name": "The Surface Context Rule",
        "body": "Use the cream web palette for web routes; keep the graphite and brass treatment attached to the companion extension.",
        "section": "colors"
      },
      {
        "name": "The Readable Data Rule",
        "body": "Preserve tabular numerals for scores, counts and timing, and keep graph labels in HTML so chart scaling does not shrink their text.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** keep the playable board visually primary within analysis and training.",
      "**Do** use flat rows, tonal containers and restrained separators for games and results.",
      "**Do** preserve route separation and the collapsible navigation behavior.",
      "**Do** pair move-summary SVG emblems with their names and counts.",
      "**Do** keep account, guest, unavailable-rating and heuristic-estimate states explicit.",
      "**Do** retain the shipped focus and reduced-motion treatments when reusing controls."
    ],
    "donts": [
      "**Don't** apply the companion graphite palette as the light web application's default.",
      "**Don't** restore a single report form as the web entry screen or a permanent analysis-library column.",
      "**Don't** require every route to fit the viewport or confine all scrolling to lists.",
      "**Don't** describe personal positions as calibrated puzzles or game-strength estimates as official ratings.",
      "**Don't** add fabricated statistics, marketing slogans or official Chess.com badge claims."
    ]
  }
}
