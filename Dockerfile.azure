# Native Stockfish distribution, pinned to the immutable official SF 19 asset.
FROM debian:bookworm-slim AS native
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /download
RUN curl --fail --location --retry 3 \
    https://github.com/official-stockfish/Stockfish/releases/download/sf_19/stockfish-linux-x86-64-universal.tar.gz \
    --output stockfish.tar.gz \
    && echo '9defc0d4e55d49c65a6d042f3e571a39fcea499ade6dbe741b53b8c65e03611f  stockfish.tar.gz' | sha256sum --check \
    && mkdir /engine && tar -xzf stockfish.tar.gz -C /engine --strip-components=1

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 ENGINE_CONCURRENCY=1 ENGINE_THREADS=2 \
    STOCKFISH_PATH=/opt/stockfish/stockfish-linux-x86-64-universal
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=native /engine /opt/stockfish
# Preserve the complete official distribution, including corresponding source.
COPY --from=native /download/stockfish.tar.gz /app/dist/engine/stockfish-19-native-distribution.tar.gz
COPY --from=build /app/dist ./dist
COPY vendor-source/stockfish-0d5dd7944f88c817c07a26bc4fb1905d5f9c46d6.tar.gz ./dist/engine/stockfish-js-source.tar.gz
COPY src/core ./src/core
COPY src/study ./src/study
COPY src/training ./src/training
COPY server ./server
RUN printf 'uci\nisready\nquit\n' | /opt/stockfish/stockfish-linux-x86-64-universal | grep -q 'uciok'
USER node
EXPOSE 8080
CMD ["node","server/index.mjs"]
