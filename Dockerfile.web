FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ARG GITHUB_SHA
RUN GITHUB_SHA="$GITHUB_SHA" npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 LOCAL_ENGINE_ONLY=true PUBLIC_REPORTS=false
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force \
    && rm -rf /app/node_modules/stockfish /app/node_modules/onnxruntime-web /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build /app/dist ./dist
COPY vendor-source/stockfish-0d5dd7944f88c817c07a26bc4fb1905d5f9c46d6.tar.gz ./dist/engine/stockfish-js-source.tar.gz
COPY src/core ./src/core
COPY src/study ./src/study
COPY src/training ./src/training
COPY server ./server
USER node
EXPOSE 8080
CMD ["node","server/index.mjs"]
